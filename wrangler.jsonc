{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "exports": {
    "RadarContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
