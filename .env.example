# RADAR - variaveis de ambiente
# Copie para .env e preencha os valores. Nunca versionar o .env.

NODE_ENV=development
PORT=3000

# Banco PostgreSQL. No Railway, use a referencia ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radar
# Defina como "true" apenas se o provedor exigir SSL sem CA confiavel.
PGSSL=false

# Segredo usado para derivar hashes de tokens de sessao e e-mail (minimo 32 caracteres).
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres

# Origens permitidas separadas por virgula (ex.: https://leeadsearch.netlify.app).
# Em producao, informe tambem o dominio publico do Railway.
APP_ORIGINS=

# URL publica usada em links de recuperacao/verificacao (sem barra final).
# Em producao com Netlify, use a URL do site Netlify.
APP_URL=

# Cookies Secure (use true em producao) e duracao da sessao em dias.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# Descoberta de empresas. A API global do servidor atende todos os usuarios.
# Apify Google Maps Scraper (compass/crawler-google-places).
APIFY_API_TOKEN=

# Alternativa: Google Maps Platform - Places API (New) e Geocoding API.
GOOGLE_MAPS_API_KEY=

# SMTP para verificacao de e-mail e recuperacao de senha (opcional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RADAR <no-reply@radar.local>

# Limites operacionais.
MAX_SEARCH_RESULTS=5
EXPORT_MAX_ROWS=5000

# Cobranca (Stripe). Sem estas variaveis o checkout responde 503 e nenhuma
# cobranca simulada e aceita. Crie os precos recorrentes mensais em BRL no
# painel do Stripe e informe os IDs price_* correspondentes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PORTAL_RETURN_PATH=/sales
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# O super administrador e definido exclusivamente no servidor pelo e-mail
# configurado em src/plans.ts (vinjvinj74@gmail.com). Nao ha variavel para
# conceder esse papel pelo frontend.
